{
  "name": "lumina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/game/config.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "train": "tsx scripts/train.ts",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "dependencies": { "phaser": "3.90.0" },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.15",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
